# Port the API runs on
PORT=5000

# MongoDB connection string (local or Atlas)
# Local example : mongodb://127.0.0.1:27017/a2z_broking
# Atlas example : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/a2z_broking
MONGODB_URI=your_mongodb_connection_string_here

# Long random string used to sign JWTs (never share or commit the real one)
JWT_SECRET=your_long_random_secret_here

# Frontend origin allowed by CORS (comma-separate for multiple origins)
CLIENT_URL=http://localhost:5173

# Session lifetimes. Accepted formats: 30m, 8h, 1d (or seconds, e.g. 28800).
# The server never issues a session shorter than SESSION_MIN_HOURS (default 8),
# even if these are set lower - a too-short value is raised and a warning is logged.
# Client session length (default 12h)
JWT_EXPIRES_IN=12h
# Admin session length (default 8h)
ADMIN_JWT_EXPIRES_IN=8h
# Minimum session length in hours enforced by the server (default 8)
SESSION_MIN_HOURS=8
