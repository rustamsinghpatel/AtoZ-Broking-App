# Port the API runs on
PORT=5000

# MongoDB connection string (local or Atlas)
# Local example : mongodb://127.0.0.1:27017/a2z_broking
# Atlas example : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/a2z_broking
MONGODB_URI=your_mongodb_connection_string_here

# Long random string used to sign JWTs (never share or commit the real one)
JWT_SECRET=your_long_random_secret_here

# Frontend origin allowed by CORS (comma-separate for multiple origins)
CLIENT_URL=http://localhost:5173

# Optional: how long a login token stays valid (default 7d)
JWT_EXPIRES_IN=7d
