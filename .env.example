# Backend API base URL (no trailing slash).
# Local development:  http://localhost:5000
# Production:         your deployed backend, e.g. https://your-backend.onrender.com
# If unset, `npm run dev` uses http://localhost:5000 and a production build
# falls back to the live API URL defined in src/services/api.js.
VITE_API_URL=http://localhost:5000
